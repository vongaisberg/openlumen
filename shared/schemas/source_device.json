{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SourceDevice",
  "type": "object",
  "required": ["name", "ip"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the source device"
    },
    "ip": {
      "type": "string",
      "format": "ipv4",
      "description": "IP address of the source device"
    },
    "packetsPerSecond": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of packets received per second from this source"
    }
  }
} 
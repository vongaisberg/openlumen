{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NetworkConfig",
  "type": "object",
  "required": ["ipConfigType", "macAddress"],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Primary key"
    },
    "ipConfigType": {
      "type": "string",
      "enum": ["dhcp", "static"],
      "default": "dhcp",
      "description": "IP configuration type"
    },
    "ipAddress": {
      "type": "string",
      "format": "ipv4",
      "description": "Static IP address or DHCP fallback"
    },
    "subnetMask": {
      "type": "string",
      "format": "ipv4",
      "description": "Subnet mask for static IP or DHCP fallback"
    },
    "gateway": {
      "type": "string",
      "format": "ipv4",
      "description": "Network gateway"
    },
    "macAddress": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}[:-]){5}([0-9A-Fa-f]{2})$",
      "description": "MAC address"
    },
    "currentIpAddress": {
      "type": "string",
      "format": "ipv4",
      "description": "Current active IP address"
    },
    "currentSubnetMask": {
      "type": "string",
      "format": "ipv4",
      "description": "Current active subnet mask"
    },
    "currentGateway": {
      "type": "string",
      "format": "ipv4",
      "description": "Current active gateway"
    }
  }
} 